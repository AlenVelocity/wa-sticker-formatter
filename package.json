{
  "name": "wa-sticker-formatter",
  "version": "5.0.0",
  "description": "Create WhatsApp stickers from images, GIFs and videos, with pack name, author and emoji metadata",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "node --test --test-reporter=spec",
    "check": "npm run lint && npm run fmt:check && npm run typecheck && npm run build && npm test",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "doc": "typedoc",
    "example": "tsx examples/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "whatsapp",
    "stickers",
    "whatsapp-stickers",
    "sticker",
    "webp",
    "baileys",
    "whatsapp-bot",
    "exif"
  ],
  "author": {
    "name": "Alen Yohannan",
    "email": "alenyohannan71@gmail.com",
    "url": "https://github.com/AlenVelocity"
  },
  "license": "MIT",
  "homepage": "https://github.com/AlenVelocity/wa-sticker-formatter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlenVelocity/wa-sticker-formatter.git"
  },
  "bugs": {
    "url": "https://github.com/AlenVelocity/wa-sticker-formatter/issues"
  },
  "funding": "https://ko-fi.com/alen01",
  "dependencies": {
    "node-webpmux": "^3.2.1",
    "sharp": "^0.34.2 || ^0.35.0"
  },
  "peerDependencies": {
    "ffmpeg-static": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "ffmpeg-static": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "protobufjs": "^7.6.6",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
